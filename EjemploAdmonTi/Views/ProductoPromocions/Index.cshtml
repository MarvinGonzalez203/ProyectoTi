@model IEnumerable<ProductoPromocion>

@{
    ViewData["Title"] = "Producto promociones";
}

<h1>Producto promociones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-percent"></i> Crear nueva promoción de producto
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Producto</th>
            <th>Promoción</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Producto != null)
                    {
                        @item.Producto.NombreProducto
                    }
                    else
                    {
                        @item.IdProducto
                    }
                </td>

                <td>
                    @if (item.Promocion != null)
                    {
                        @item.Promocion.NombrePromocion
                    }
                    else
                    {
                        @item.IdPromocion
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdProductoPromocion" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdProductoPromocion" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdProductoPromocion" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>