@model IEnumerable<TicketSoporte>

@{
    ViewData["Title"] = "Tickets de soporte";
}

<h1>Tickets de soporte</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-ticket-detailed-fill"></i> Crear nuevo ticket
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Cliente</th>
            <th>Pedido</th>
            <th>SLA</th>
            <th>Asunto</th>
            <th>Descripción</th>
            <th>Prioridad</th>
            <th>Estado del ticket</th>
            <th>Fecha de creación</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Cliente != null)
                    {
                        @item.Cliente.Nombre
                    }
                    else
                    {
                        @item.IdCliente
                    }
                </td>

                <td>
                    @if (item.Pedido != null)
                    {
                        @("Pedido #" + item.Pedido.IdPedido)
                    }
                    else
                    {
                        @item.IdPedido
                    }
                </td>

                <td>
                    @if (item.SLA != null)
                    {
                        @item.SLA.Prioridad
                    }
                    else
                    {
                        @item.IdSLA
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.Asunto)</td>

                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>

                <td>@Html.DisplayFor(modelItem => item.Prioridad)</td>

                <td>@Html.DisplayFor(modelItem => item.EstadoTicket)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaCreacion)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdTicket" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdTicket" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdTicket" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>