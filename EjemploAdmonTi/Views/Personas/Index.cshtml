@model IEnumerable<Persona>

@{
    ViewData["Title"] = "Personas";
}

<h1>Personas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-person-plus-fill"></i> Crear nueva persona
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Usuario</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>

                <td>@Html.DisplayFor(modelItem => item.Apellido)</td>

                <td>
                    @if (item.User != null)
                    {
                        @item.User.UserName
                    }
                    else
                    {
                        @item.UserId
                    }
                </td>

                <td>
                    @if (item.Inactivo)
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.PersonaId" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.PersonaId" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.PersonaId" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>