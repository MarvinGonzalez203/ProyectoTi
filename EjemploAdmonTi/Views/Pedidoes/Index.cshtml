@model IEnumerable<Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<h1>Pedidos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-cart-plus-fill"></i> Crear nuevo pedido
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Cliente</th>
            <th>Canal de venta</th>
            <th>Tienda</th>
            <th>Fecha del pedido</th>
            <th>Estado del pedido</th>
            <th>Total del pedido</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Cliente != null)
                    {
                        @item.Cliente.Nombre
                    }
                    else
                    {
                        @item.IdCliente
                    }
                </td>

                <td>
                    @if (item.CanalVenta != null)
                    {
                        @item.CanalVenta.NombreCanal
                    }
                    else
                    {
                        @item.IdCanal
                    }
                </td>

                <td>
                    @if (item.Tienda != null)
                    {
                        @item.Tienda.NombreTienda
                    }
                    else
                    {
                        @item.IdTienda
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.FechaPedido)</td>

                <td>@Html.DisplayFor(modelItem => item.EstadoPedido)</td>

                <td>Q @item.TotalPedido.ToString("N2")</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdPedido" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdPedido" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdPedido" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>