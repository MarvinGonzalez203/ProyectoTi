@model IEnumerable<Devolucion>

@{
    ViewData["Title"] = "Devoluciones";
}

<h1>Devoluciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-arrow-counterclockwise"></i> Crear nueva devolución
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Pedido</th>
            <th>Motivo de devolución</th>
            <th>Fecha de devolución</th>
            <th>Estado de devolución</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Pedido != null)
                    {
                        @item.Pedido.IdPedido
                    }
                    else
                    {
                        @item.IdPedido
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.MotivoDevolucion)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaDevolucion)</td>

                <td>@Html.DisplayFor(modelItem => item.EstadoDevolucion)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdDevolucion" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdDevolucion" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdDevolucion" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>