@model IEnumerable<ReservaStock>

@{
    ViewData["Title"] = "Reservas de stock";
}

<h1>Reservas de stock</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-box-arrow-in-down"></i> Crear nueva reserva
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Pedido</th>
            <th>Producto</th>
            <th>Inventario</th>
            <th>Cantidad reservada</th>
            <th>Fecha de reserva</th>
            <th>Estado de reserva</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Pedido != null)
                    {
                        @("Pedido #" + item.Pedido.IdPedido)
                    }
                    else
                    {
                        @item.IdPedido
                    }
                </td>

                <td>
                    @if (item.Producto != null)
                    {
                        @item.Producto.NombreProducto
                    }
                    else
                    {
                        @item.IdProducto
                    }
                </td>

                <td>
                    @if (item.Inventario != null)
                    {
                        @("Inventario #" + item.Inventario.IdInventario)
                    }
                    else
                    {
                        @item.IdInventario
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.CantidadReservada)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaReserva)</td>

                <td>@Html.DisplayFor(modelItem => item.EstadoReserva)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>