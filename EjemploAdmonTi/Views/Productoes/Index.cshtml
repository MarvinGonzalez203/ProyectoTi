@model IEnumerable<Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-box-seam"></i> Crear nuevo producto
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>SKU</th>
            <th>Nombre del producto</th>
            <th>Descripción</th>
            <th>Unidad de medida</th>
            <th>Precio base</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Sku)</td>

                <td>@Html.DisplayFor(modelItem => item.NombreProducto)</td>

                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>

                <td>@Html.DisplayFor(modelItem => item.UnidadMedida)</td>

                <td>Q @item.PrecioBase.ToString("N2")</td>

                <td>@Html.DisplayFor(modelItem => item.Estado)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdProducto" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdProducto" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdProducto" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>