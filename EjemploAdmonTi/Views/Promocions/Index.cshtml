@model IEnumerable<Promocion>

@{
    ViewData["Title"] = "Promociones";
}

<h1>Promociones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-tags-fill"></i> Crear nueva promoción
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombre de la promoción</th>
            <th>Descripción</th>
            <th>Descuento</th>
            <th>Fecha de inicio</th>
            <th>Fecha de fin</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NombrePromocion)</td>

                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>

                <td>@item.Descuento.ToString("N2") %</td>

                <td>@Html.DisplayFor(modelItem => item.FechaInicio)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaFin)</td>

                <td>@Html.DisplayFor(modelItem => item.Estado)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdPromocion" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdPromocion" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdPromocion" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>