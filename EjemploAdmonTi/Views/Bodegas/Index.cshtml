@model IEnumerable<Bodega>

@{
    ViewData["Title"] = "Bodegas";
}

<h1>Bodegas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-building-add"></i> Crear nueva bodega
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombre de la bodega</th>
            <th>Ubicación</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NombreBodega)</td>

                <td>@Html.DisplayFor(modelItem => item.Ubicacion)</td>

                <td>@Html.DisplayFor(modelItem => item.Estado)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdBodega" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdBodega" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdBodega" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>