@model IEnumerable<SLA>

@{
    ViewData["Title"] = "SLA";
}

<h1>SLA</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-clock-history"></i> Crear nuevo SLA
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Contrato</th>
            <th>Prioridad</th>
            <th>Tiempo de respuesta</th>
            <th>Tiempo de resolución</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.ContratoServicio != null)
                    {
                        @("Contrato #" + item.ContratoServicio.IdContrato)
                    }
                    else
                    {
                        @item.IdContrato
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.Prioridad)</td>

                <td>@Html.DisplayFor(modelItem => item.TiempoRespuesta)</td>

                <td>@Html.DisplayFor(modelItem => item.TiempoResolucion)</td>

                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdSLA" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdSLA" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdSLA" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>