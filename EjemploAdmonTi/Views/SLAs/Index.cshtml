@model IEnumerable<SLA>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Prioridad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TiempoRespuesta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TiempoResolucion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContratoServicio)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Prioridad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TiempoRespuesta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TiempoResolucion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContratoServicio.IdContrato)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdSLA">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdSLA">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdSLA">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
