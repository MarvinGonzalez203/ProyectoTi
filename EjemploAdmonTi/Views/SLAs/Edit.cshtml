@model SLA

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>SLA</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdSLA" />
            <div class="form-group">
                <label asp-for="IdContrato" class="control-label"></label>
                <select asp-for="IdContrato" class="form-control" asp-items="ViewBag.IdContrato"></select>
                <span asp-validation-for="IdContrato" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Prioridad" class="control-label"></label>
                <input asp-for="Prioridad" class="form-control" />
                <span asp-validation-for="Prioridad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TiempoRespuesta" class="control-label"></label>
                <input asp-for="TiempoRespuesta" class="form-control" />
                <span asp-validation-for="TiempoRespuesta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TiempoResolucion" class="control-label"></label>
                <input asp-for="TiempoResolucion" class="form-control" />
                <span asp-validation-for="TiempoResolucion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
