@model IEnumerable<CanalVenta>

@{
    ViewData["Title"] = "Canales de venta";
}

<h1>Canales de venta</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-diagram-3-fill"></i> Crear nuevo canal
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombre del canal</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NombreCanal)</td>

                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdCanal" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdCanal" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdCanal" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>