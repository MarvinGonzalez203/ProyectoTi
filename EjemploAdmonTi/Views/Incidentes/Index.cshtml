@model IEnumerable<Incidente>

@{
    ViewData["Title"] = "Incidentes";
}

<h1>Incidentes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i> Crear nuevo incidente
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>SLA</th>
            <th>Tipo de incidente</th>
            <th>Descripción</th>
            <th>Estado del incidente</th>
            <th>Fecha de inicio</th>
            <th>Fecha de cierre</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.SLA != null)
                    {
                        @item.SLA.Prioridad
                    }
                    else
                    {
                        @item.IdSLA
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.TipoIncidente)</td>

                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>

                <td>@Html.DisplayFor(modelItem => item.EstadoIncidente)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaInicio)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaCierre)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdIncidente" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdIncidente" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdIncidente" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>