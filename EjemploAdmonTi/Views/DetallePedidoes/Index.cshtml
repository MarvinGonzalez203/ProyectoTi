@model IEnumerable<DetallePedido>

@{
    ViewData["Title"] = "Detalle de pedidos";
}

<h1>Detalle de pedidos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-list-ul"></i> Crear nuevo detalle
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Pedido</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
            <th>Subtotal</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Pedido != null)
                    {
                        @item.Pedido.IdPedido
                    }
                    else
                    {
                        @item.IdPedido
                    }
                </td>

                <td>
                    @if (item.Producto != null)
                    {
                        @item.Producto.NombreProducto
                    }
                    else
                    {
                        @item.IdProducto
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.Cantidad)</td>

                <td>Q @item.PrecioUnitario.ToString("N2")</td>

                <td>Q @item.Subtotal.ToString("N2")</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdDetallePedido" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdDetallePedido" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdDetallePedido" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>