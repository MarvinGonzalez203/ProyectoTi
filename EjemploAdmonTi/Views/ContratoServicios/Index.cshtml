@model IEnumerable<ContratoServicio>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaFin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MontoImplementacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MontoMensual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoContrato)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProveedorTecnologico)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaInicio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaFin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MontoImplementacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MontoMensual)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoContrato)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProveedorTecnologico.IdProveedor)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdContrato">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdContrato">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdContrato">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
