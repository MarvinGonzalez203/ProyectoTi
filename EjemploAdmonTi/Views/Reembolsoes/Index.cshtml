@model IEnumerable<Reembolso>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MontoReembolso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoReembolso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaReembolso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Devolucion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MontoReembolso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoReembolso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaReembolso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Devolucion.IdDevolucion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdReembolso">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdReembolso">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdReembolso">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
