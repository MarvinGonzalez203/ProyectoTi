                <select asp-for="IdDevolucion" class ="form-control" asp-items="ViewBag.IdDevolucion"></select>
            </div>
            <div class="form-group">
                <label asp-for="MontoReembolso" class="control-label"></label>
                <input asp-for="MontoReembolso" class="form-control" />
