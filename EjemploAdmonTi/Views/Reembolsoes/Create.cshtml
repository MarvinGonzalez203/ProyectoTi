            </div>
            <div class="form-group">
                <label asp-for="EstadoReembolso" class="control-label"></label>
                <input asp-for="EstadoReembolso" class="form-control" />
                <span asp-validation-for="EstadoReembolso" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaReembolso" class="control-label"></label>
                <input asp-for="FechaReembolso" class="form-control" />
                <span asp-validation-for="FechaReembolso" class="text-danger"></span>
