@model IEnumerable<Inventario>

@{
    ViewData["Title"] = "Inventarios";
}

<h1>Inventarios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-clipboard-data-fill"></i> Crear nuevo inventario
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Producto</th>
            <th>Tienda</th>
            <th>Bodega</th>
            <th>Stock disponible</th>
            <th>Stock reservado</th>
            <th>Fecha de actualización</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Producto != null)
                    {
                        @item.Producto.NombreProducto
                    }
                    else
                    {
                        @item.IdProducto
                    }
                </td>

                <td>
                    @if (item.Tienda != null)
                    {
                        @item.Tienda.NombreTienda
                    }
                    else
                    {
                        @item.IdTienda
                    }
                </td>

                <td>
                    @if (item.Bodega != null)
                    {
                        @item.Bodega.NombreBodega
                    }
                    else
                    {
                        @item.IdBodega
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.StockDisponible)</td>

                <td>@Html.DisplayFor(modelItem => item.StockReservado)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaActualizacion)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdInventario" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdInventario" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdInventario" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>