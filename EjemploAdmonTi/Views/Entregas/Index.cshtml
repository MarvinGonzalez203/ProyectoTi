@model IEnumerable<Entrega>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TipoEntrega)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DireccionEntrega)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaProgramada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoEntrega)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pedido)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TipoEntrega)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DireccionEntrega)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaProgramada)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoEntrega)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Pedido.IdPedido)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdEntrega">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdEntrega">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdEntrega">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
