@model IEnumerable<Entrega>

@{
    ViewData["Title"] = "Entregas";
}

<h1>Entregas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-truck"></i> Crear nueva entrega
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Pedido</th>
            <th>Tipo de entrega</th>
            <th>Dirección de entrega</th>
            <th>Fecha programada</th>
            <th>Estado de entrega</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Pedido != null)
                    {
                        @item.Pedido.IdPedido
                    }
                    else
                    {
                        @item.IdPedido
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.TipoEntrega)</td>

                <td>@Html.DisplayFor(modelItem => item.DireccionEntrega)</td>

                <td>@Html.DisplayFor(modelItem => item.FechaProgramada)</td>

                <td>@Html.DisplayFor(modelItem => item.EstadoEntrega)</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdEntrega" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdEntrega" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdEntrega" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>